# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Never commit the real .env file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Local dev needs nothing here: it uses a debug token
# printed in the browser console. For a hosted build, set ONE of these:
# a debug token you registered in Firebase console > App Check (the contest rules accept this)...
VITE_APPCHECK_DEBUG_TOKEN=
# ...or a reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_SITE_KEY=
